              "description": "The title follows the identifier on its line.",
              "properties": {
                "kind": {
                  "const": "sameLine"
                }
              },
              "additionalProperties": false
            },
            {
              "description": "The title sits below the identifier, softReturns soft returns down.",
              "properties": {
                "kind": {
