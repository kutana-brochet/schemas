          "enum": [
            "unquoted"
          ]
        },
        "emphasis": {
          "description": "The emphasis set on the term.",
          "enum": [
            "bold"
          ]
        },
        "separator": {
          "description": "What stands between the term and its meaning, piece by piece; [] for nothing.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "description": "One piece of a separator.",
            "type": "object",
